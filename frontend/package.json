{
  "name": "hackutd2026-drill-night",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../backend/spacetimedb",
    "spacetime:publish": "spacetime publish --module-path ../backend/spacetimedb hackutd2026-h9s81 --server maincloud",
    "spacetime:logs": "spacetime logs hackutd2026-h9s81 --server maincloud -f"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  }
}
